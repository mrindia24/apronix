{
  "name": "apronix-tech",
  "version": "1.0.0",
  "private": true,
  "description": "Apronix Tech - Digital Experiences. Measurable Growth.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint --max-warnings=100",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "jose": "6.2.13",
    "lucide-react": "0.475.0",
    "next": "15.5.28",
    "nodemailer": "6.9.16",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.10",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.55.0",
    "postcss": "8.5.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
