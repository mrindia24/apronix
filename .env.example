# ------------------------------------------------------------------------------
# Apronix Tech — environment variables
# Copy to .env (local) or add these to your hosting provider's env settings.
# NEVER commit real credentials.
# ------------------------------------------------------------------------------

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, RDS, Railway, self-hosted…)
# Example: postgresql://user:password@host:5432/apronix?schema=public&sslmode=require
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/apronix?schema=public"

# Public base URL, no trailing slash. Used for canonical URLs, sitemap.xml,
# Open Graph tags and structured data. Must be the production domain in prod.
NEXT_PUBLIC_SITE_URL="https://apronixtech.com"

# Session signing / hashing secret. MUST be at least 32 random characters.
# Generate: openssl rand -base64 48
AUTH_SECRET=""

# ── Administrator bootstrap (used by `npm run admin:create` / seed only) ──────
# There is no public registration page. After the first admin exists you can
# delete these two values from production.
ADMIN_EMAIL="you@apronixtech.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Apronix Admin"

# ── Public site settings ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="Apronix Tech"

# WhatsApp business number, digits only with country code (no + or spaces).
# When set, WhatsApp buttons appear on the contact and service pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
WHATSAPP_NUMBER=""

# Agency contact email shown in the footer / privacy policy.
SUPPORT_EMAIL="hello@apronixtech.com"

# ── Email delivery (optional) ────────────────────────────────────────────────
# Without these, enquiries are still saved to the database and visible in
# /admin/leads, but no notification or acknowledgement email is sent.
# Works with Resend, Postmark, SES, Mailgun, Google Workspace, Zoho, etc.
#   Resend  → host smtp.resend.com, port 587, user "resend", password = API key
#   Postmark→ host smtp.postmarkapp.com, port 587, user = server token
#   SES     → host email-smtp.<region>.amazonaws.com, port 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# From address (must be a domain you have verified with your provider)
MAIL_FROM="Apronix Tech <no-reply@apronixtech.com>"

# Where new-enquiry notifications are delivered (the agency inbox)
ENQUIRY_INBOX_EMAIL="hello@apronixtech.com"

# ── Media storage (optional) ─────────────────────────────────────────────────
# Left blank → uploads are written to public/uploads and served by Next.js.
# Set these to use any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze…)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Analytics (optional, consent-gated) ──────────────────────────────────────
# GA4 measurement ID (G-XXXXXXX) and/or Plausible domain. Nothing is loaded
# until the visitor accepts the consent banner.
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# ── Anti-spam (optional) ─────────────────────────────────────────────────────
# Cloudflare Turnstile secret key. Honeypot + timing checks work without it.
TURNSTILE_SECRET_KEY=""

# Max enquiries accepted from one IP per hour (default 5)
LEAD_RATE_LIMIT_PER_HOUR="5"
